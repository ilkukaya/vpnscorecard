---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import RankRow from '../components/RankRow.astro';
import Disclosure from '../components/Disclosure.astro';
import type { CollectionEntry } from 'astro:content';
import { t, localized, dateFmt, type Lang } from '../i18n';
import { allVPNs } from '../lib/vpns';
import { guidesFor, guideLangs, splitSlug } from '../lib/content';
import { breadcrumbSchema, faqSchema, ORG_ID } from '../lib/seo';
import { abs } from '../lib/site';

interface Props { lang: Lang; entry: CollectionEntry<'guides'> }
const { lang, entry } = Astro.props;
const L = (p: string) => localized(p, lang);
const slug = splitSlug(entry.slug).slug;
const path = `/guides/${slug}/`;
const { Content, headings } = await entry.render();
const d = entry.data;
const available = await guideLangs(slug);
const related = (await guidesFor(lang)).filter((g) => g.slug !== entry.slug).slice(0, 3);
const toc = headings.filter((h) => h.depth === 2);
const schema = [
  {
    '@type': 'Article', '@id': abs(L(path)) + '#article', headline: d.title, description: d.description, inLanguage: lang,
    datePublished: d.date, dateModified: d.updated || d.date, image: abs('/og/default.png'),
    author: { '@type': 'Organization', name: 'VPNScorecard Editorial Team', url: abs(L('/about/')) }, publisher: { '@id': ORG_ID },
    mainEntityOfPage: abs(L(path)),
  },
  breadcrumbSchema([{ name: t(lang, 'nav.home'), path: L('/') }, { name: t(lang, 'nav.guides'), path: L('/guides/') }, { name: d.title, path: L(path) }]),
  ...(d.faq?.length ? [faqSchema(d.faq)] : []),
];
---
<Base lang={lang} path={path} type="article" title={d.title} description={d.description} schema={schema} available={available} published={d.date} modified={d.updated || d.date}>
  <article class="wrap py-10 md:py-14">
    <div class="mx-auto max-w-prose">
      <Breadcrumbs items={[{ name: t(lang, 'nav.home'), href: L('/') }, { name: t(lang, 'nav.guides'), href: L('/guides/') }, { name: d.title, href: L(path) }]} />
      <p class="eyebrow mt-6">{t(lang, `guides.categories.${d.category}`)}</p>
      <h1 class="h-display mt-2 text-4xl leading-tight md:text-5xl">{d.title}</h1>
      <p class="mt-4 text-lg text-ink-2">{d.description}</p>
      <p class="mt-4 text-sm text-ink-3">{t(lang, 'common.byline')} · {t(lang, 'common.updated')} <time datetime={d.updated || d.date}>{dateFmt(lang, d.updated || d.date)}</time> · {t(lang, 'guides.minRead', { n: d.readTime })}</p>
      <div class="mt-8"><QuickAnswer lang={lang}>{d.summary}</QuickAnswer></div>
      {toc.length > 2 && (
        <nav class="mt-8 rounded-2xl border border-line bg-white p-5" aria-label={t(lang, 'guides.toc')}>
          <p class="text-sm font-bold">{t(lang, 'guides.toc')}</p>
          <ol class="mt-3 list-decimal space-y-1.5 ps-5 text-sm text-ink-2">{toc.map((h) => <li><a class="hover:text-accent-ink" href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose prose-lg mt-10 prose-headings:scroll-mt-24 prose-a:font-medium">
        <Content />
      </div>
      <AdSlot />
      {d.faq?.length ? <div class="mt-12"><FAQ items={d.faq} title={t(lang, 'common.faqTitle')} /></div> : null}
    </div>

    <section class="mx-auto mt-16 max-w-4xl">
      <h2 class="h-display text-2xl md:text-3xl">{t(lang, 'guides.ourPicks')}</h2>
      <Disclosure lang={lang} class="mt-3" />
      <div class="mt-5 grid gap-3">{allVPNs.slice(0, 3).map((v, i) => <RankRow vpn={v} rank={i + 1} lang={lang} place={`guide-${slug}`} />)}</div>
    </section>

    {related.length > 0 && (
      <section class="mx-auto mt-16 max-w-4xl">
        <h2 class="h-display text-2xl md:text-3xl">{t(lang, 'guides.related')}</h2>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {related.map((g) => (
            <a href={L(`/guides/${splitSlug(g.slug).slug}/`)} class="card group p-5 hover:shadow-lift">
              <p class="text-base font-bold leading-snug group-hover:text-accent-ink">{g.data.title}</p>
              <p class="mt-2 line-clamp-2 text-sm text-ink-3">{g.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>
