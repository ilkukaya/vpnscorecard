---
import Base from '../layouts/Base.astro';
import RankRow from '../components/RankRow.astro';
import ScoreBadge from '../components/ScoreBadge.astro';
import VPNMark from '../components/VPNMark.astro';
import CompareTable from '../components/CompareTable.astro';
import Disclosure from '../components/Disclosure.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import CTA from '../components/CTA.astro';
import { t, tRaw, localized, monthYear, numberFmt, vpnText, type Lang } from '../i18n';
import { allVPNs, LAST_REVIEWED, scoreCategories, freePlan, lowestPrice } from '../lib/vpns';
import { bestLists } from '../lib/lists';
import { itemListSchema, faqSchema } from '../lib/seo';
import { guidesFor, splitSlug } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => localized(p, lang);
const year = new Date(LAST_REVIEWED).getUTCFullYear();
const top = allVPNs.slice(0, 3);
const best = allVPNs[0];
const value = bestLists.find((b) => b.key === 'cheap')!.pick()[0];
const free = allVPNs.find((v) => freePlan(v))!;
const privacy = bestLists.find((b) => b.key === 'privacy')!.pick()[0];
const faq = tRaw<{ q: string; a: string }[]>(lang, 'home.faq');
const guides = (await guidesFor(lang)).slice(0, 3);
const filters = ['all', 'streaming', 'privacy', 'budget', 'p2p', 'beginners', 'free_tier', 'multi_device'];
const s10 = (v: any) => numberFmt(lang, v.scores.total / 10, { minimumFractionDigits: 1 });

const schema = [
  itemListSchema(t(lang, 'home.rankingsTitle', { year }), allVPNs.map((v) => ({ name: v.name, path: L(`/reviews/${v.slug}/`) }))),
  faqSchema(faq),
];
---
<Base lang={lang} path="/" title={t(lang, 'home.metaTitle', { year })} description={t(lang, 'home.metaDescription', { count: allVPNs.length, year })} schema={schema}>
  <!-- Hero -->
  <section class="border-b border-line">
    <div class="wrap grid grid-cols-1 gap-10 py-12 md:py-16 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-14">
      <div>
        <p class="eyebrow">{t(lang, 'home.eyebrow', { date: monthYear(lang, LAST_REVIEWED) })}</p>
        <h1 class="h-display mt-3 text-[2.35rem] leading-[1.08] md:text-6xl">{t(lang, 'home.h1', { year })}</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-2">{t(lang, 'home.lead', { count: allVPNs.length })}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#rankings" class="btn-primary">{t(lang, 'home.ctaRankings')}</a>
          <a href={L('/quiz/')} class="btn-ghost">{t(lang, 'home.ctaQuiz')}</a>
        </div>
        <ul class="mt-8 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6 text-sm">
          <li><strong class="block font-display text-2xl text-ink num">{numberFmt(lang, allVPNs.length)}</strong><span class="text-ink-3">{t(lang, 'home.statVpns')}</span></li>
          <li><strong class="block font-display text-2xl text-ink num">{numberFmt(lang, scoreCategories.length)}</strong><span class="text-ink-3">{t(lang, 'home.statCategories')}</span></li>
          <li><strong class="block font-display text-2xl text-ink num">0</strong><span class="text-ink-3">{t(lang, 'home.statPaid')}</span></li>
        </ul>
      </div>
      <div class="card min-w-0 p-2">
        <p class="px-4 pt-3 pb-2 text-xs font-semibold uppercase tracking-wider text-ink-3">{t(lang, 'home.podium')}</p>
        <ol class="divide-y divide-line">
          {top.map((v, i) => (
            <li class="flex items-center gap-4 px-4 py-4">
              <span class="w-5 font-display text-2xl font-semibold text-ink-4 num">{i + 1}</span>
              <VPNMark vpn={v} size={40} />
              <div class="min-w-0 flex-1">
                <a href={L(`/reviews/${v.slug}/`)} class="font-bold text-ink hover:text-accent-ink">{v.name}</a>
                <p class="truncate text-[13px] text-ink-3">{vpnText(lang, v.id).tagline}</p>
              </div>
              <ScoreBadge total={v.scores.total} lang={lang} size="sm" showLabel={false} />
            </li>
          ))}
        </ol>
        <div class="px-4 pb-4 pt-2"><CTA id={best.id} place="home-podium" class="w-full">{t(lang, 'home.ctaTop', { name: best.name })}</CTA></div>
      </div>
    </div>
  </section>

  <div class="wrap mt-10 grid gap-4">
    <QuickAnswer lang={lang}>
      <ul class="grid gap-1.5 sm:grid-cols-2">
        <li><strong>{t(lang, 'home.qa.overall')}:</strong> <a class="link" href={L(`/reviews/${best.slug}/`)}>{best.name}</a> ({s10(best)}/10)</li>
        <li><strong>{t(lang, 'home.qa.value')}:</strong> <a class="link" href={L(`/reviews/${value.slug}/`)}>{value.name}</a> ({t(lang, 'common.from')} {numberFmt(lang, lowestPrice(value.id)!.price, { style: 'currency', currency: lowestPrice(value.id)!.currency })}{t(lang, 'common.perMonth')})</li>
        <li><strong>{t(lang, 'home.qa.privacy')}:</strong> <a class="link" href={L(`/reviews/${privacy.slug}/`)}>{privacy.name}</a></li>
        <li><strong>{t(lang, 'home.qa.free')}:</strong> <a class="link" href={L(`/reviews/${free.slug}/`)}>{free.name}</a></li>
      </ul>
    </QuickAnswer>
    <Disclosure lang={lang} />
  </div>

  <!-- Rankings -->
  <section id="rankings" class="wrap scroll-mt-20 pt-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="h-display text-3xl md:text-4xl">{t(lang, 'home.rankingsTitle', { year })}</h2>
        <p class="mt-2 text-ink-3">{t(lang, 'home.rankingsSub', { date: monthYear(lang, LAST_REVIEWED) })}</p>
      </div>
      <a href={L('/methodology/')} class="link text-sm">{t(lang, 'home.howWeScoreLink')}</a>
    </div>
    <div class="no-scrollbar -mx-4 mt-6 flex gap-2 overflow-x-auto px-4 pb-1" role="toolbar" aria-label={t(lang, 'home.filterLabel')} id="filters">
      {filters.map((f, i) => (
        <button type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}
          class="shrink-0 rounded-full border border-line bg-white px-4 py-2 text-sm font-medium text-ink-2 hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white">
          {t(lang, `filters.${f}`)}
        </button>
      ))}
    </div>
    <div class="mt-5 grid gap-3" id="rank-list">
      {allVPNs.map((v, i) => <RankRow vpn={v} rank={i + 1} lang={lang} place="home-rankings" featured={i === 0} />)}
    </div>
    <p id="filter-empty" class="hidden mt-4 text-ink-3">{t(lang, 'home.filterEmpty')}</p>
  </section>

  <!-- Compare top 4 -->
  <section class="wrap pt-20">
    <h2 class="h-display text-3xl md:text-4xl">{t(lang, 'home.compareTitle')}</h2>
    <p class="mt-2 mb-6 text-ink-3">{t(lang, 'home.compareSub')}</p>
    <CompareTable vpns={allVPNs.slice(0, 4)} lang={lang} place="home-table" />
  </section>

  <!-- Best for -->
  <section class="wrap pt-20">
    <h2 class="h-display text-3xl md:text-4xl">{t(lang, 'home.bestForTitle')}</h2>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {bestLists.map((b) => {
        const pick = b.pick()[0];
        return (
          <a href={L(`/best/${b.key}/`)} class="card group p-4 transition-shadow hover:shadow-lift">
            <p class="text-[15px] font-semibold text-ink group-hover:text-accent-ink">{t(lang, `best.lists.${b.key}.short`)}</p>
            {pick && <p class="mt-1 text-xs text-ink-3">{t(lang, 'home.topPick')}: <span class="font-medium text-ink-2">{pick.name}</span></p>}
          </a>
        );
      })}
    </div>
  </section>

  <AdSlot class="wrap" />

  <!-- How we score -->
  <section class="wrap pt-16">
    <div class="grid gap-10 rounded-3xl bg-ink p-8 text-white md:grid-cols-2 md:p-12">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-bright">{t(lang, 'home.methodEyebrow')}</p>
        <h2 class="mt-3 font-display text-3xl font-semibold md:text-4xl">{t(lang, 'home.methodTitle')}</h2>
        <p class="mt-4 leading-relaxed text-[#C9CDD3]">{t(lang, 'home.methodText')}</p>
        <a href={L('/methodology/')} class="btn mt-6 bg-white text-ink hover:bg-paper">{t(lang, 'home.methodCta')}</a>
      </div>
      <ul class="grid gap-3 self-center">
        {scoreCategories.map((c) => (
          <li class="flex items-center gap-4">
            <span class="w-14 shrink-0 font-display text-2xl font-semibold text-accent-bright num">{numberFmt(lang, c.max)}%</span>
            <span class="text-[15px]">{t(lang, `categories.${c.key}`)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="wrap pt-20">
      <div class="flex items-end justify-between gap-4">
        <h2 class="h-display text-3xl md:text-4xl">{t(lang, 'home.guidesTitle')}</h2>
        <a href={L('/guides/')} class="link text-sm">{t(lang, 'common.viewAll')}</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {guides.map((g) => (
          <a href={L(`/guides/${splitSlug(g.slug).slug}/`)} class="card group p-6 transition-shadow hover:shadow-lift">
            <p class="eyebrow">{t(lang, `guides.categories.${g.data.category}`)}</p>
            <h3 class="mt-2 text-lg font-bold leading-snug text-ink group-hover:text-accent-ink">{g.data.title}</h3>
            <p class="mt-2 line-clamp-3 text-sm text-ink-3">{g.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap pt-20">
    <div class="mx-auto max-w-3xl"><FAQ items={faq} title={t(lang, 'common.faqTitle')} /></div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#filters [data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('#rank-list > article');
  const empty = document.getElementById('filter-empty');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      rows.forEach((r) => {
        const ok = f === 'all' || (r.dataset.bestFor || '').split(' ').includes(f);
        r.hidden = !ok;
        if (ok) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    })
  );
</script>
