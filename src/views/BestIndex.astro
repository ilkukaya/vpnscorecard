---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VPNMark from '../components/VPNMark.astro';
import { t, localized, type Lang } from '../i18n';
import { LAST_REVIEWED } from '../lib/vpns';
import { bestLists } from '../lib/lists';
import { breadcrumbSchema } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => localized(p, lang);
const year = new Date(LAST_REVIEWED).getUTCFullYear();
---
<Base lang={lang} path="/best/" title={t(lang, 'bestIndex.metaTitle', { year })} description={t(lang, 'bestIndex.metaDescription')} schema={[breadcrumbSchema([{ name: t(lang, 'nav.home'), path: L('/') }, { name: t(lang, 'nav.best'), path: L('/best/') }])]}>
  <div class="wrap py-10 md:py-14">
    <Breadcrumbs items={[{ name: t(lang, 'nav.home'), href: L('/') }, { name: t(lang, 'nav.best'), href: L('/best/') }]} />
    <h1 class="h-display mt-5 text-4xl md:text-5xl">{t(lang, 'bestIndex.h1', { year })}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-2">{t(lang, 'bestIndex.lead')}</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {bestLists.map((b) => {
        const picks = b.pick().slice(0, 3);
        return (
          <a href={L(`/best/${b.key}/`)} class="card group p-6 hover:shadow-lift">
            <h2 class="text-lg font-bold group-hover:text-accent-ink">{t(lang, `best.lists.${b.key}.h1`, { year })}</h2>
            <div class="mt-4 flex items-center gap-2">{picks.map((v) => <VPNMark vpn={v} size={30} />)}<span class="ms-2 text-xs text-ink-3">{picks.map((v) => v.name).join(' · ')}</span></div>
          </a>
        );
      })}
    </div>
  </div>
</Base>
