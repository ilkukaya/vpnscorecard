---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RankRow from '../components/RankRow.astro';
import CompareTable from '../components/CompareTable.astro';
import Disclosure from '../components/Disclosure.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import { t, localized, numberFmt, dateFmt, vpnText, type Lang } from '../i18n';
import { LAST_REVIEWED, allVPNs } from '../lib/vpns';
import { bestLists, type BestList } from '../lib/lists';
import { breadcrumbSchema, itemListSchema, faqSchema } from '../lib/seo';

interface Props { lang: Lang; list: BestList }
const { lang, list } = Astro.props;
const L = (p: string) => localized(p, lang);
const k = `best.lists.${list.key}`;
const year = new Date(LAST_REVIEWED).getUTCFullYear();
const picks = list.pick();
const top = picks[0];
const path = `/best/${list.key}/`;
const h1 = t(lang, `${k}.h1`, { year });
const topic = t(lang, `${k}.short`);
const s10 = (v: any) => numberFmt(lang, v.scores.total / 10, { minimumFractionDigits: 1 });
const faq = [
  { q: t(lang, 'best.faq.whichQ', { topic }), a: t(lang, 'best.faq.whichA', { topic, name: top.name, score: s10(top), runner: picks[1]?.name || top.name }) },
  { q: t(lang, 'best.faq.howQ', { topic }), a: t(lang, `${k}.criteria`) },
  { q: t(lang, 'best.faq.legalQ'), a: t(lang, 'best.faq.legalA') },
];
const schema = [
  breadcrumbSchema([{ name: t(lang, 'nav.home'), path: L('/') }, { name: t(lang, 'nav.best'), path: L('/best/') }, { name: topic, path: L(path) }]),
  itemListSchema(h1, picks.map((v) => ({ name: v.name, path: L(`/reviews/${v.slug}/`) }))),
  faqSchema(faq),
];
const related = bestLists.filter((b) => b.key !== list.key).slice(0, 8);
---
<Base lang={lang} path={path} type="article" title={h1} description={t(lang, `${k}.metaDescription`, { year, name: top.name })} schema={schema} modified={LAST_REVIEWED}>
  <div class="wrap py-10 md:py-14">
    <Breadcrumbs items={[{ name: t(lang, 'nav.home'), href: L('/') }, { name: t(lang, 'nav.best'), href: L('/best/') }, { name: topic, href: L(path) }]} />
    <div class="mt-5 max-w-3xl">
      <h1 class="h-display text-4xl md:text-5xl">{h1}</h1>
      <p class="mt-3 text-sm text-ink-3">{t(lang, 'common.byline')} · {t(lang, 'common.updated')} <time datetime={LAST_REVIEWED}>{dateFmt(lang, LAST_REVIEWED)}</time></p>
      <p class="mt-5 text-lg leading-relaxed text-ink-2">{t(lang, `${k}.intro`)}</p>
    </div>
    <div class="mt-8 max-w-3xl">
      <QuickAnswer lang={lang}>{t(lang, 'best.quick', { topic, name: top.name, score: s10(top), tagline: vpnText(lang, top.id).tagline })}</QuickAnswer>
      <Disclosure lang={lang} class="mt-4" />
    </div>

    <section class="mt-10 grid gap-3">
      {picks.map((v, i) => <RankRow vpn={v} rank={i + 1} lang={lang} place={`best-${list.key}`} featured={i === 0} highlight={i === 0 ? t(lang, 'best.topPick') : undefined} />)}
    </section>

    <section class="mt-14">
      <h2 class="h-display text-2xl md:text-3xl">{t(lang, 'best.howPicked')}</h2>
      <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-ink-2">{t(lang, `${k}.criteria`)} {t(lang, 'best.howPickedGeneric')}</p>
    </section>

    <section class="mt-14">
      <h2 class="h-display text-2xl md:text-3xl">{t(lang, 'best.compareTop')}</h2>
      <div class="mt-5"><CompareTable vpns={picks.slice(0, 3)} lang={lang} place={`best-${list.key}-table`} /></div>
    </section>

    <AdSlot />

    <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_20rem]">
      <FAQ items={faq} title={t(lang, 'common.faqTitle')} />
      <aside class="card h-fit p-6">
        <h2 class="text-base font-bold">{t(lang, 'best.more')}</h2>
        <ul class="mt-3 space-y-2 text-sm">{related.map((b) => <li><a class="link" href={L(`/best/${b.key}/`)}>{t(lang, `best.lists.${b.key}.short`)}</a></li>)}</ul>
      </aside>
    </div>
  </div>
</Base>
