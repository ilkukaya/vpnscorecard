---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; label?: string }
const { lang, label } = Astro.props;
---
<aside class="rounded-2xl border border-accent/25 bg-accent-wash p-5 md:p-6" data-pagefind-weight="2">
  <p class="eyebrow mb-2">{label || t(lang, 'common.quickAnswer')}</p>
  <div class="text-[15px] leading-relaxed text-ink md:text-base"><slot /></div>
</aside>
