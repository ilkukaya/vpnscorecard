---
import Logo from './Logo.astro';
import { languages, langs, localized, t, type Lang, defaultLang } from '../i18n';
import { bestLists } from '../lib/lists';

interface Props { lang: Lang; path: string; available: Lang[] }
const { lang, path, available } = Astro.props;
const L = (p: string) => localized(p, lang);
const nav = [
  { href: L('/reviews/'), label: t(lang, 'nav.reviews') },
  { href: L('/compare/'), label: t(lang, 'nav.compare') },
  { href: L('/best/'), label: t(lang, 'nav.best') },
  { href: L('/pricing/'), label: t(lang, 'nav.pricing') },
  { href: L('/guides/'), label: t(lang, 'nav.guides') },
];
const bestTop = bestLists.slice(0, 8);
const current = localized(path, lang);
---
<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={L('/')} aria-label="VPNScorecard" class="shrink-0"><Logo /></a>

    <nav class="hidden lg:flex items-center gap-1" aria-label={t(lang, 'nav.main')}>
      {nav.map((n) => (
        <a href={n.href} class={`rounded-lg px-3 py-2 text-[14px] font-medium transition-colors hover:bg-white hover:text-ink ${current.startsWith(n.href) ? 'text-ink bg-white' : 'text-ink-2'}`}>{n.label}</a>
      ))}
      <a href={L('/tools/what-is-my-ip/')} class="rounded-lg px-3 py-2 text-[14px] font-medium text-ink-2 hover:bg-white hover:text-ink">{t(lang, 'nav.ip')}</a>
    </nav>

    <div class="flex items-center gap-1.5">
      <a href={L('/search/')} class="grid h-10 w-10 place-items-center rounded-lg text-ink-2 hover:bg-white hover:text-ink" aria-label={t(lang, 'nav.search')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <details class="relative group" data-dropdown>
        <summary class="flex h-10 cursor-pointer list-none items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-semibold uppercase text-ink-2 hover:bg-white hover:text-ink [&::-webkit-details-marker]:hidden" aria-label={t(lang, 'nav.language')}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
          {lang}
        </summary>
        <div class="absolute end-0 mt-2 hidden w-56 group-open:block max-h-[70vh] overflow-auto rounded-xl border border-line bg-white p-1.5 shadow-lift">
          {langs.map((l) => (
            <a href={available.includes(l) ? localized(path, l) : localized('/', l)} hreflang={languages[l].hreflang} lang={languages[l].hreflang}
              class={`flex items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-paper ${l === lang ? 'font-semibold text-accent-ink' : 'text-ink-2'}`}>
              <span>{languages[l].name}</span><span class="text-xs uppercase text-ink-4">{l}</span>
            </a>
          ))}
        </div>
      </details>
      <details class="group/menu lg:hidden" data-dropdown>
        <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-lg text-ink hover:bg-white [&::-webkit-details-marker]:hidden" aria-label={t(lang, 'nav.menu')}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="fixed inset-x-0 top-16 hidden h-[calc(100dvh-4rem)] overflow-y-auto group-open/menu:block border-t border-line bg-paper px-4 pb-10 pt-4">
          <nav class="grid gap-1" aria-label={t(lang, 'nav.main')}>
            {nav.map((n) => <a href={n.href} class="rounded-xl bg-white px-4 py-3.5 text-base font-semibold text-ink border border-line">{n.label}</a>)}
            <a href={L('/tools/what-is-my-ip/')} class="rounded-xl bg-white px-4 py-3.5 text-base font-semibold text-ink border border-line">{t(lang, 'nav.ip')}</a>
            <a href={L('/quiz/')} class="rounded-xl bg-white px-4 py-3.5 text-base font-semibold text-ink border border-line">{t(lang, 'nav.quiz')}</a>
          </nav>
          <p class="eyebrow mt-6 mb-2">{t(lang, 'nav.best')}</p>
          <div class="grid grid-cols-2 gap-2">
            {bestTop.map((b) => <a href={L(`/best/${b.key}/`)} class="rounded-lg border border-line bg-white px-3 py-2.5 text-sm text-ink-2">{t(lang, `best.lists.${b.key}.short`)}</a>)}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
<script>
  // Close open dropdowns on outside click / Escape
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details[data-dropdown][open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('details[data-dropdown][open]').forEach((d) => d.removeAttribute('open'));
  });
</script>
