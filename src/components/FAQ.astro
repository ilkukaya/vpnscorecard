---
interface Props { items: { q: string; a: string }[]; title?: string; id?: string }
const { items, title, id = 'faq' } = Astro.props;
---
<section id={id} class="scroll-mt-24">
  {title && <h2 class="h-display text-2xl md:text-3xl mb-5">{title}</h2>}
  <div class="divide-y divide-line rounded-2xl border border-line bg-white">
    {items.map((f, i) => (
      <details class="group px-5 py-1" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-start font-semibold text-ink [&::-webkit-details-marker]:hidden">
          <h3 class="text-[15px] leading-snug">{f.q}</h3>
          <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="pb-5 text-[15px] leading-relaxed text-ink-2">{f.a}</p>
      </details>
    ))}
  </div>
</section>
