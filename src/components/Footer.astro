---
import Logo from './Logo.astro';
import { languages, langs, localized, t, type Lang } from '../i18n';
import { bestLists, comparePairs, pairSlug } from '../lib/lists';

interface Props { lang: Lang; path: string; available: Lang[] }
const { lang, path, available } = Astro.props;
const L = (p: string) => localized(p, lang);
const pairs = comparePairs().slice(0, 6);
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-ink text-[#C9CDD3]">
  <div class="wrap py-14">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <a href={L('/')} class="inline-block rounded-lg bg-paper px-3 py-2"><Logo /></a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed">{t(lang, 'footer.about')}</p>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-[#9aa1ab]">{t(lang, 'footer.lawful')}</p>
      </div>
      <div class="md:col-span-8 grid grid-cols-2 gap-8 sm:grid-cols-4">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-white">{t(lang, 'nav.best')}</p>
          <ul class="space-y-2 text-sm">{bestLists.slice(0, 7).map((b) => <li><a class="hover:text-white" href={L(`/best/${b.key}/`)}>{t(lang, `best.lists.${b.key}.short`)}</a></li>)}</ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-white">{t(lang, 'nav.compare')}</p>
          <ul class="space-y-2 text-sm">{pairs.map(([a, b]) => <li><a class="hover:text-white" href={L(`/compare/${pairSlug(a, b)}/`)} dir="ltr">{a.name} vs {b.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-white">{t(lang, 'footer.resources')}</p>
          <ul class="space-y-2 text-sm">
            <li><a class="hover:text-white" href={L('/reviews/')}>{t(lang, 'nav.reviews')}</a></li>
            <li><a class="hover:text-white" href={L('/guides/')}>{t(lang, 'nav.guides')}</a></li>
            <li><a class="hover:text-white" href={L('/methodology/')}>{t(lang, 'nav.methodology')}</a></li>
            <li><a class="hover:text-white" href={L('/vpn-legality/')}>{t(lang, 'nav.legality')}</a></li>
            <li><a class="hover:text-white" href={L('/tools/what-is-my-ip/')}>{t(lang, 'nav.ip')}</a></li>
            <li><a class="hover:text-white" href={L('/quiz/')}>{t(lang, 'nav.quiz')}</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-white">{t(lang, 'footer.company')}</p>
          <ul class="space-y-2 text-sm">
            <li><a class="hover:text-white" href={L('/about/')}>{t(lang, 'nav.about')}</a></li>
            <li><a class="hover:text-white" href={L('/contact/')}>{t(lang, 'nav.contact')}</a></li>
            <li><a class="hover:text-white" href={L('/editorial-policy/')}>{t(lang, 'nav.editorial')}</a></li>
            <li><a class="hover:text-white" href={L('/affiliate-disclosure/')}>{t(lang, 'nav.disclosure')}</a></li>
            <li><a class="hover:text-white" href={L('/privacy/')}>{t(lang, 'nav.privacy')}</a></li>
            <li><a class="hover:text-white" href={L('/terms/')}>{t(lang, 'nav.terms')}</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-12 border-t border-white/10 pt-6">
      <p class="text-xs leading-relaxed text-[#9aa1ab]">{t(lang, 'footer.disclosure')}</p>
      <nav class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs" aria-label={t(lang, 'nav.language')}>
        {langs.map((l) => <a href={available.includes(l) ? localized(path, l) : localized('/', l)} hreflang={languages[l].hreflang} lang={languages[l].hreflang} class={l === lang ? 'text-white font-semibold' : 'hover:text-white'}>{languages[l].name}</a>)}
      </nav>
      <p class="mt-5 text-xs text-[#9aa1ab]">© {year} VPNScorecard. {t(lang, 'footer.rights')}</p>
    </div>
  </div>
</footer>
