---
import { goPath } from '../lib/vpns';
interface Props { id: string; place: string; class?: string; variant?: 'primary' | 'ghost'; small?: boolean }
const { id, place, class: cls = '', variant = 'primary', small = false } = Astro.props;
---
<a href={goPath(id)} rel="sponsored nofollow noopener" target="_blank" data-go={id} data-place={place}
  class={`${variant === 'primary' ? 'btn-primary' : 'btn-ghost'} ${small ? 'btn-sm' : ''} ${cls}`}>
  <slot />
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" class="rtl:-scale-x-100"><path d="M7 17 17 7M8 7h9v9"/></svg>
</a>
