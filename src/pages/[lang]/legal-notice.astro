---
import View from '../../views/Simple.astro';
import { nonDefaultLangs, type Lang } from '../../i18n';
export const getStaticPaths = () => nonDefaultLangs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---
<View lang={lang} kind="legalnotice" path="/legal-notice/" />
